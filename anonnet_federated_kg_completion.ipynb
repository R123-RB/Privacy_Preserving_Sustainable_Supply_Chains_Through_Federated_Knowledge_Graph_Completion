    "    if bad.any():\n",
    "        raise RuntimeError(\"could not build filtered ranking candidates\")\n",
    "    cand = np.stack([A, B], 1).reshape(P, k, 2)\n",
    "    if corrupt == 'tail':\n",
    "        return cand\n",
