    "def assert_client_isolation(client, expected_local_edges):\n",
    "    n = client['num_nodes']\n",
    "    assert client['static_x'].shape[0] == n, \"client holds features for nodes it does not own\"\n",
    "    for name in ('pairs', 'neg_pool'):\n",
