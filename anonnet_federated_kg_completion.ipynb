    "        assert t.ndim == 2 and t.shape[1] == 2, f\"{name} must be [E, 2]\"\n",
    "        assert t.numel() == 0 or (int(t.min()) >= 0 and int(t.max()) < n), f\"{name} references a node outside the client\"\n",
