    "    def forward(self, z, pairs):\n",
    "        assert pairs.dim() == 2 and pairs.size(1) == 2, f\"pairs must be [E, 2], got {tuple(pairs.shape)}\"\n",
    "        z = F.normalize(z, p=2, dim=-1)\n",
    "        return (z[pairs[:, 0]] * z[pairs[:, 1]]).sum(-1) * self.tau\n",
    "\n",
