    "def assert_no_heldout_in_graph(edge_index, heldout_pairs, name):\n",
    "    \"\"\"No held-out pair, in EITHER direction, may exist in a message-passing graph.\"\"\"\n",
    "    ei = edge_index.numpy().T\n",
