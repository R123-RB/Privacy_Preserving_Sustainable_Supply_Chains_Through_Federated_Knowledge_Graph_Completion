    "    return {'test': evaluate_model(gm, ctx, 'test', thr), 'best_step': best['step'], 'history': hist, 'model': gm,\n",
    "            'uplink_bytes_per_client_round': float(np.mean(uplink)) if uplink else 0.0, 'num_params': sum(p.numel() for p in gm.parameters())}\n",
