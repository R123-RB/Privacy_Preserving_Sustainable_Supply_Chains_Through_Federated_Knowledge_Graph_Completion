    "    # the relationship signal -- ranking MRR collapses to the random baseline.\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "    def forward(self, z, edge_index):\n",
    "        z = F.normalize(z, p=2, dim=-1)\n",
    "        src, dst = z[edge_index[0]], z[edge_index[1]]\n",
    "        return (src * dst).sum(dim=-1)\n",
