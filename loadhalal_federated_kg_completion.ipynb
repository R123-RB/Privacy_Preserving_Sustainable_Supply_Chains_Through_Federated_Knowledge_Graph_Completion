    "            super().__init__()\n",
    "            self.conv1 = RGCNConv(in_dim, hidden_dim, num_relations,\n",
    "                                  num_bases=num_bases, root_weight=True)\n",
    "            self.conv2 = RGCNConv(hidden_dim, hidden_dim, num_relations,\n",
    "                                  num_bases=num_bases, root_weight=True)\n",
